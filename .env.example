# Copy this file to .env and fill in the values. Never commit .env.

# --- Server (API) ---
# Postgres connection string. On Neon use the "Pooled connection" string (host contains "-pooler").
DATABASE_URL=postgres://user:password@localhost:5432/step_ritual
# Long random secret used to sign login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Optional: comma-separated web origins allowed to call the API (localhost is always allowed).
CORS_ORIGINS=
# Optional: port for the local server (default 5000).
PORT=5000

# --- App (Expo) ---
# Public URL of the API, without a trailing slash. From a phone on the same Wi-Fi use your
# computer's LAN IP (e.g. http://192.168.1.20:5000), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:5000
# Only needed for Android development/production builds (Expo Go does not need it).
GOOGLE_MAPS_ANDROID_API_KEY=
